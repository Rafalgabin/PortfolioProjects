SELECT
	*
FROM car_sales
LIMIT 10;

SELECT
  COUNT(*) 				      AS total_rows,
  COUNT(year_made) 	  	AS year_made_nonnull,
  COUNT(maker) 			    AS maker_nonnull,
  COUNT(model) 			    AS model_nonnull,
  COUNT("trim") 		  	AS trim_nonnull,
  COUNT(body) 			    AS body_nonnull,
  COUNT(transmission) 	AS transmission_nonnull,
  COUNT(vin) 				    AS vin_nonnull,
  COUNT("state") 		  	AS state_nonnull,
  COUNT("condition") 		AS condition_nonnull,
  COUNT(odometer_miles) AS odometer_miles_nonnull,
  COUNT(color) 			    AS color_nonnull,
  COUNT(interior) 		  AS interior_nonnull,
  COUNT(seller) 		  	AS seller_nonnull,
  COUNT(mmr) 			    	AS mmr_nonnull,
  COUNT(selling_price) 	AS selling_price_nonnull,
  COUNT(sale_time) 		  AS sale_time_nonnull,
  COUNT(sale_date) 		  AS sale_date_nonnull
FROM car_sales;

SELECT 
	DISTINCT year_made as distinct_year_made
FROM car_sales;

------------------------------maker column

SELECT 
	DISTINCT maker as distinct_marker
FROM car_sales;

UPDATE car_sales
SET maker = INITCAP(maker)
WHERE maker IS NOT NULL AND maker <> INITCAP(maker);

UPDATE car_sales 
SET maker = CASE
	WHEN maker = 'Mazda tk' THEN 'Mazda'
	WHEN maker = 'Mercedes-b' THEN 'Mercedes-Benz'
	WHEN maker = 'vw' THEN 'Volkswagen'
	WHEN maker = 'Landrover' THEN 'Land Rover'
	WHEN maker = 'Hyundai tk' THEN 'Hyundai'
	WHEN maker IN ('Gmc', 'Gmc truck') THEN 'GMC'
	WHEN maker IN ('Ford tk', 'Ford truck') THEN 'Ford'
	WHEN maker = 'Chev truck' THEN 'Chevrolet'
	WHEN maker IN ('Dodge tk', 'dot') THEN 'Dodge'
	WHEN maker = 'Bmw' THEN 'BMW'
	ELSE maker
END
WHERE maker IN (
	'Mazda tk', 'Mercedes-b','vw', 'Landrover', 'Hyundai tk', 'Gmc', 'Gmc truck'
	,'Ford tk', 'Ford truck', 'Chev truck', 'Dodge tk', 'dot', 'Bmw' 
);

