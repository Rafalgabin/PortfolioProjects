ALTER TABLE car_sales
ADD COLUMN maker_region TEXT;

UPDATE car_sales
SET maker_region = CASE UPPER(LEFT(vin, 1))
    WHEN '1' THEN 'USA'
    WHEN '4' THEN 'USA'
    WHEN '5' THEN 'USA'
    WHEN '2' THEN 'Canada'
    WHEN '3' THEN 'Mexico'
    WHEN '6' THEN 'Australia'
    WHEN '9' THEN 'Brazil'
    WHEN 'J' THEN 'Japan'
    WHEN 'K' THEN 'South Korea'
    WHEN 'L' THEN 'China'
    WHEN 'M' THEN 'India'
    WHEN 'N' THEN 'Turkey'
    WHEN 'S' THEN 'UK'
    WHEN 'T' THEN 'Hungary/Switzerland'
    WHEN 'V' THEN 'France/Spain'
    WHEN 'W' THEN 'Germany'
    WHEN 'X' THEN 'Russia'
    WHEN 'Y' THEN 'Sweden/Finland'
    WHEN 'Z' THEN 'Italy'
    ELSE 'Unknown'
END;

SELECT
	maker_region
	,COUNT (*)
FROM car_sales
GROUP BY maker_region;

