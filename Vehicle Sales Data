------------------------------body column

SELECT 
	DISTINCT body as distinct_body 
FROM car_sales;

UPDATE car_sales
SET body =
  LEFT(body, POSITION(' ' IN body)) || 
  UPPER(SUBSTRING(body FROM POSITION(' ' IN body) + 1 FOR 1)) ||
  SUBSTRING(body FROM POSITION(' ' IN body) + 2)
WHERE body LIKE '% %';

ALTER TABLE car_sales ADD COLUMN body_type_standard TEXT;

UPDATE car_sales
SET body_type_standard = CASE
  WHEN body IN ('Sedan', 'G Sedan') THEN 'Sedan'
  WHEN body = 'SUV' THEN 'SUV'
  WHEN body = 'Hatchback' THEN 'Hatchback'
  WHEN body = 'Minivan' THEN 'Minivan'
  WHEN body IN ('Van', 'E-Series Van', 'Promaster Cargo Van', 'Transit Van', 'Ram Van') THEN 'Van'
  WHEN body IN ('Coupe', 'G Coupe', 'Genesis Coupe', 'Koup', 'CTS Coupe', 'CTS-V Coupe', 'Elantra Coupe', 'Q60 Coupe', 'G37 Coupe') THEN 'Coupe'
  WHEN body IN ('Convertible', 'G Convertible', 'Beetle Convertible', 'GranTurismo Convertible', 'Q60 Convertible', 'G37 Convertible') THEN 'Convertible'
  WHEN body IN ('Wagon', 'CTS Wagon', 'TSX Sport Wagon', 'CTS-V Wagon') THEN 'Wagon'
  WHEN body IN ('Crew Cab', 'SuperCrew', 'SuperCab', 'Regular Cab', 'Extended Cab', 'Quad Cab', 'Double Cab', 'CrewMax Cab', 'King Cab', 'Access Cab', 'Club Cab', 'Mega Cab', 'Cab Plus', 'Cab Plus 4', 'Xtracab') THEN 'Pickup Truck'
	ELSE 'Other'
END
WHERE body_type_standard IS NULL;

SELECT
	body_type_standard
	,COUNT (body_type_standard)
FROM car_sales
GROUP BY body_type_standard;

ALTER TABLE car_sales
DROP COLUMN body;

ALTER TABLE car_sales
RENAME COLUMN body_type_standard TO body;

